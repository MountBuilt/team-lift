[Unit]
Description=Team Lift banter safety timer (30s; event watcher is primary)
Documentation=file:%h/team-lift/docs/ops-nuc.md

[Timer]
# Safety net for clock-driven work (morning/evening push, daily/weekly report)
# and any missed Firestore events. Live comments are woken by
# teamlift-banter-watch.service via onSnapshot on config/banter.pendingAt.
# 30s keeps free-tier probe reads modest (~5.8k doc reads/day for the 2-doc idle probe).
OnBootSec=30
OnUnitActiveSec=30
AccuracySec=5
Persistent=true
Unit=teamlift-banter.service

[Install]
WantedBy=timers.target

rules_version = '2';

// Sledged security rules.
//
// Read docs/sledged/03-architecture.md §5 before changing anything here.
//
// Two ideas carry the whole model:
//
// 1. MEMBERSHIP LIVES IN THE AUTH TOKEN. `onCrewMembership` writes a `crews`
//    custom claim whenever crews/{id}.memberIds changes. Rules read it off the
//    token. We never call get() from a rule: a get() costs a document read on
//    every evaluation, and the "read my own membership doc" pattern is exactly
//    where somebody eventually writes `allow read: if true` to make a test go
//    green.
//
// 2. RAW BODYWEIGHT NEVER TOUCHES A CREW-READABLE DOCUMENT. Entry docs are read
//    by every crew member, so they carry only weightDelta and a hasWeight flag.
//    Actual kg lives in users/{uid}/weights/{date}, owner-readable only. Hiding
//    a field in the UI is not a control; the document is readable directly.
//
// Client deletes are denied everywhere. Nothing in the app needs one (messages
// soft-delete, entries merge), and account deletion runs server-side through
// the Admin SDK, which bypasses rules entirely. The same is true of every
// "server" write below: the Admin SDK is not subject to rules, so `if false`
// is how we say "functions only".

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Membership straight off the token. Never a get().
    //
    // Defaulted, because a solo user has no `crews` claim at all and reading a
    // missing key errors the whole rule out. Without this, a user's very first
    // entry (logged before they have joined any crew) is denied.
    function myCrews() {
      return request.auth.token.get('crews', []);
    }

    function inCrew(crewId) {
      return signedIn() && myCrews().hasAny([crewId]);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function changedKeys() {
      return incoming().diff(existing()).affectedKeys();
    }

    // True when an update touches none of the listed fields.
    function untouched(fields) {
      return !changedKeys().hasAny(fields);
    }

    // ------------------------------------------------------------------ users

    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
                    && incoming().keys().hasAll(['displayName', 'colour'])
                    // A new account may not mint its own entitlement or crews.
                    && incoming().get('entitlement', 'free') == 'free'
                    && incoming().get('crews', []).size() == 0
                    && incoming().get('trialStartedAt', null) == null;

      // Everything that decides what a user is entitled to is server-written.
      allow update: if isSelf(uid)
                    && untouched([
                         'entitlement',
                         'crews',
                         'trialStartedAt',
                         'trialEndsAt',
                         'dmTrialUsed'
                       ]);

      allow delete: if false;   // account deletion is a Cloud Function

      // The only place a raw kg exists. Not readable by crewmates, ever.
      match /weights/{date} {
        allow read, create, update: if isSelf(uid);
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------ crews

    match /crews/{crewId} {
      allow read: if inCrew(crewId);

      // You may create a crew, with yourself as its only member.
      allow create: if signedIn()
                    && incoming().createdBy == request.auth.uid
                    && incoming().memberIds == [request.auth.uid];

      // Admin may rename, retune banter, rotate the code. Membership is NOT
      // client-writable: joining goes through a callable that checks the invite
      // code, otherwise anyone could add themselves to any crew they can name.
      allow update: if inCrew(crewId)
                    && existing().createdBy == request.auth.uid
                    && untouched(['memberIds', 'createdBy', 'createdAt']);

      allow delete: if false;

      match /members/{uid} {
        allow read: if inCrew(crewId);
        allow write: if false;                  // server only
      }

      match /threads/{threadId} {
        allow read: if inCrew(crewId);
        allow write: if false;                  // server only

        match /messages/{msgId} {
          // Removed content is invisible to everyone. Authors can still see
          // their own held messages, which avoids a confusing disappearing act
          // while the pre-post filter runs.
          allow read: if inCrew(crewId)
                      && (existing().moderation != 'removed'
                          || isSelf(existing().userId));

          allow create: if inCrew(crewId)
                        && incoming().kind == 'user'
                        && incoming().userId == request.auth.uid
                        && incoming().text is string
                        && incoming().text.size() > 0
                        && incoming().text.size() <= 160
                        && incoming().deleted == false
                        // A client may not forge Aiden, nor pre-clear itself
                        // through the moderation filter.
                        && incoming().moderation == 'pending'
                        && incoming().get('role', null) == null;

          // Authors bin their own messages. Nothing else about a message is
          // ever editable by a client, including its text.
          allow update: if inCrew(crewId)
                        && isSelf(existing().userId)
                        && existing().kind == 'user'
                        && changedKeys().hasOnly(['deleted'])
                        && incoming().deleted == true;

          allow delete: if false;
        }
      }

      match /feedLines/{entryId} {
        allow read: if inCrew(crewId) && existing().moderation != 'removed';
        allow write: if false;                  // server only
      }

      match /notebook/{docId} {
        allow read, write: if false;            // Aiden's private notes
      }

      match /state/{docId} {
        allow read, write: if false;            // server only
      }
    }

    // ---------------------------------------------------------------- entries

    // Shared with the crew. Carries weightDelta, never weightKg.
    match /entries/{entryId} {

      function ownsEntry() {
        return signedIn() && existing().userId == request.auth.uid;
      }

      function sharesACrew() {
        return signedIn()
            && existing().crewIds is list
            && existing().crewIds.size() > 0
            && myCrews().hasAny(existing().crewIds);
      }

      // Only the caller's own key inside the reactions map may change.
      function onlyOwnReaction() {
        return changedKeys().hasOnly(['reactions'])
            && incoming().reactions
                 .diff(existing().reactions)
                 .affectedKeys()
                 .hasOnly([request.auth.uid]);
      }

      allow read: if ownsEntry() || sharesACrew();

      allow create: if signedIn()
                    && incoming().userId == request.auth.uid
                    // One entry per person per day, by construction.
                    && entryId == request.auth.uid + '_' + incoming().date
                    // You cannot log into a crew you are not in. An empty list
                    // is fine: that is a solo user with no crew yet.
                    && incoming().crewIds is list
                    && myCrews().hasAll(incoming().crewIds)
                    // Reject the shape outright so raw weight cannot creep back
                    // into a crew-readable document.
                    && !incoming().keys().hasAny(['weightKg', 'weight']);

      allow update: if (signedIn()
                        && existing().userId == request.auth.uid
                        && incoming().userId == request.auth.uid
                        && untouched(['userId', 'date', 'createdAt'])
                        // Re-checked on update: a user who joins a crew after
                        // logging may backfill crewIds, but only with crews
                        // they are actually in.
                        && myCrews().hasAll(incoming().crewIds)
                        && !incoming().keys().hasAny(['weightKg', 'weight']))
                    // ...or a crewmate reacting, and nothing else.
                    || (sharesACrew() && onlyOwnReaction());

      allow delete: if false;
    }

    // -------------------------------------------------------------------- DMs

    match /dms/{uid}/messages/{msgId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
                    && incoming().kind == 'user'
                    && incoming().text.size() <= 160
                    && incoming().moderation == 'pending';
      allow update, delete: if false;
    }

    // -------------------------------------------------------- moderation queue

    // Write-only for users: anyone can report, nobody can read the queue or
    // see what has been reported about them.
    match /reports/{reportId} {
      allow create: if signedIn()
                    && incoming().reporterUid == request.auth.uid
                    && incoming().status == 'open';
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------ public docs

    // Minimum build version, kill switches, announcements. Read before sign-in.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // Just enough for the web landing page to say "Join the Sunday Crew" before
    // the user has signed in. Written server-side; never contains member data.
    match /inviteCodes/{code} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------ deny

    // Anything not matched above is denied. Explicit so a new collection fails
    // closed rather than inheriting somebody's permissive parent match.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
